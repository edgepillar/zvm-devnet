# Copy to .env to change any of these; docker compose reads it. Every value
# here has a default, so the devnet runs without a .env at all.

# The address browsers and tools reach the gateway at. Every page is built
# against it and token URIs are written with it, so set it before the first
# `up` when the devnet is not on this machine, e.g. http://192.168.1.20:47080
# or https://devnet.example.org. Changing it later rebuilds the pages on the
# next `docker compose up -d`.
ZVM_DEVNET_URL=http://localhost:47080

# Where the gateway is published on the host. 127.0.0.1 keeps it to this
# machine; 0.0.0.0 opens it to the network.
ZVM_DEVNET_BIND=127.0.0.1
ZVM_DEVNET_PORT=47080

# The address that holds every admin role: the owner of Mozaic, zchan, ZNS,
# Spark, the NFT marketplace and the farm, and Uniswap's feeToSetter. Empty:
# the first EVM test account of go-zenon's devnet mnemonic (README.md), whose
# key is public. Set your own before the first `up` for a private admin.
DEVNET_ADMIN=

# The execution engine. Karst needs an op-reth with Osaka and Jovian.
OP_RETH_IMAGE=ghcr.io/paradigmxyz/op-reth:v1.10.2

# Where the node links a transaction's NoM block: the stock Zenon explorer,
# from `docker compose --profile l1-explorer up -d`.
L1_EXPLORER_URL=http://localhost:46000
